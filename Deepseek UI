local function createCard(title, desc, type)
    local card = create("Frame", { Size = UDim2.new(1, -10, 0, 72), BackgroundColor3 = C_BG, BackgroundTransparency = 0.1, BorderSizePixel = 0, Parent = cardList })
    corner(card, 8)
    create("TextLabel", { Size = UDim2.new(1, -20, 0, 22), Position = UDim2.new(0, 15, 0, 12), BackgroundTransparency = 1, Text = title, TextColor3 = C_TEXT, TextSize = 14, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
    create("TextLabel", { Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 15, 0, 38), BackgroundTransparency = 1, Text = desc, TextColor3 = C_SUB, TextSize = 12, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Parent = card })

    if type == "toggle" then
        local tBg = create("Frame", { Size = UDim2.new(0, 34, 0, 18), Position = UDim2.new(1, -45, 0.5, -9), BackgroundColor3 = C_BLUE, BorderSizePixel = 0, Parent = card })
        corner(tBg, 9)
        local dot = create("Frame", { Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(1, -16, 0.5, -7), BackgroundColor3 = C_WHITE, BorderSizePixel = 0, Parent = tBg })
        corner(dot, 7)
    elseif type == "slider" then
        create("TextLabel", { Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -75, 0.5, -10), BackgroundTransparency = 1, Text = "32", TextColor3 = C_SUB, TextSize = 13, Font = FONT, Parent = card })
        local sTrack = create("Frame", { Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(1, -45, 0.5, -9), BackgroundColor3 = C_WHITE, BorderSizePixel = 0, Parent = card })
        corner(sTrack, 3)
    elseif type == "icon" then
        create("ImageLabel", { Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(1, -35, 0.5, -8), BackgroundTransparency = 1, Image = ICON_STAR, ImageColor3 = C_SUB, Parent = card })
    end
end

