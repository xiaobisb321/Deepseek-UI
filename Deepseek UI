local function addData(x, title, value, isGrad, barColor)
    local f = create("Frame", { Size = UDim2.new(0, 120, 1, 0), Position = UDim2.new(0, x, 0, 0), BackgroundTransparency = 1, Parent = topBar })
    create("TextLabel", { Size = UDim2.new(0, 35, 0, 15), Position = UDim2.new(0, 10, 0, 6), BackgroundTransparency = 1, Text = title, TextColor3 = C_WHITE, TextSize = 12, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
    create("TextLabel", { Size = UDim2.new(0, 75, 0, 15), Position = UDim2.new(0, 45, 0, 6), BackgroundTransparency = 1, Text = value, TextColor3 = C_WHITE, TextSize = 12, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
    local barBg = create("Frame", { Size = UDim2.new(1, -20, 0, 3), Position = UDim2.new(0, 10, 0, 26), BackgroundColor3 = Color3.fromRGB(50, 50, 50), BorderSizePixel = 0, Parent = f })
    local fill = create("Frame", { Size = UDim2.new(0.6, 0, 1, 0), BackgroundColor3 = barColor, BorderSizePixel = 0, Parent = barBg })
    if isGrad then create("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(220, 255, 0), Color3.fromRGB(0, 255, 100)), Parent = fill }) end
end

